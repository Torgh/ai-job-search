{
  "name": "pracuj-cli",
  "version": "1.0.0",
  "description": "CLI for searching job offers on Pracuj.pl (Poland) - public pages, zero runtime dependencies.",
  "type": "module",
  "main": "src/cli.ts",
  "bin": {
    "pracuj-search": "src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
